datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  CHEF
  WAITER
  DRIVER
}

enum OrderType {
  DELIVERY
  DINE_IN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  READY_TO_SERVE
  DELIVERED
  SERVED
  COMPLETED
  CANCELLED
}

model User {
  id                String         @id @default(uuid())
  name              String
  email             String         @unique
  password          String
  phone             String?
  role              Role           @default(CUSTOMER)
  restaurantId      String?
  restaurant        Restaurant?    @relation(fields: [restaurantId], references: [id])
  orders            Order[]
  reviews           Review[]
  addresses         Address[]
  submittedFoods    Food[]         @relation("SubmittedFoods")
  approvedFoods     Food[]         @relation("ApprovedFoods")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Restaurant {
  id            String         @id @default(uuid())
  name          String
  logo          String?
  coverImage    String?
  description   String?
  address       String
  latitude      Float?
  longitude     Float?
  phone         String
  openingHours  String
  closingHours  String
  isDelivery    Boolean        @default(true)
  isDineIn      Boolean        @default(true)
  isOpen        Boolean        @default(true)
  rating        Float          @default(0.0)
  staff         User[]
  foods         Food[]
  orders        Order[]
  tables        Table[]
  inventories   Inventory[]
  createdAt     DateTime       @default(now())
}

model FoodCategory {
  id            String         @id @default(uuid())
  name          String         @unique
  image         String?
  foods         Food[]
}

model Food {
  id                String         @id @default(uuid())
  name              String
  description       String?
  price             Float
  image             String?
  isPopular         Boolean        @default(false)
  isAvailable       Boolean        @default(true)
  preparationTime   Int            @default(15)
  isVegetarian      Boolean        @default(false)
  isVegan           Boolean        @default(false)
  isGlutenFree      Boolean        @default(false)
  spicyLevel        String         @default("NONE")
  status            String         @default("APPROVED")
  submittedBy       String?
  submitter         User?          @relation("SubmittedFoods", fields: [submittedBy], references: [id])
  approvedBy        String?
  approver          User?          @relation("ApprovedFoods", fields: [approvedBy], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  categoryId        String
  category          FoodCategory   @relation(fields: [categoryId], references: [id])
  restaurantId      String
  restaurant        Restaurant     @relation(fields: [restaurantId], references: [id])
  orderItems        OrderItem[]
  reviews           Review[]
  addons            FoodAddon[]
}

model FoodAddon {
  id            String         @id @default(uuid())
  name          String
  price         Float
  foodId        String
  food          Food           @relation(fields: [foodId], references: [id])
}

model Table {
  id            String         @id @default(uuid())
  tableNumber   String
  capacity      Int
  status        String         @default("AVAILABLE")
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  orders        Order[]
}

model Order {
  id                  String         @id @default(uuid())
  customerId          String
  customer            User           @relation(fields: [customerId], references: [id])
  restaurantId        String
  restaurant          Restaurant     @relation(fields: [restaurantId], references: [id])
  tableId             String?
  table               Table?         @relation(fields: [tableId], references: [id])
  addressId           String?
  address             Address?       @relation(fields: [addressId], references: [id])
  deliveryAddress     String?
  latitude            Float?
  longitude           Float?
  driverId            String?        
  orderType           OrderType
  status              OrderStatus    @default(PENDING)
  totalAmount         Float
  deliveryFee         Float          @default(0.0)
  discount            Float          @default(0.0)
  specialInstructions String?
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payment             Payment?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodId        String
  food          Food           @relation(fields: [foodId], references: [id])
  quantity      Int
  unitPrice     Float
}

model OrderStatusHistory {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        OrderStatus
  notes         String?
  timestamp     DateTime       @default(now())
}

model Payment {
  id            String         @id @default(uuid())
  orderId       String         @unique
  order         Order          @relation(fields: [orderId], references: [id])
  amount        Float
  method        String
  status        String         @default("PENDING")
  transactionId String?
  createdAt     DateTime       @default(now())
}

model Inventory {
  id            String         @id @default(uuid())
  itemName      String
  quantity      Float
  unit          String
  minimumStock  Float
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
}

model Review {
  id            String         @id @default(uuid())
  rating        Int
  comment       String?
  image         String?
  customerId    String
  customer      User           @relation(fields: [customerId], references: [id])
  foodId        String
  food          Food           @relation(fields: [foodId], references: [id])
  createdAt     DateTime       @default(now())
}

model Address {
  id            String         @id @default(uuid())
  title         String
  fullAddress   String
  latitude      Float?
  longitude     Float?
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  orders        Order[]
}

model Zone {
  id            String         @id @default(uuid())
  name          String         @unique
  restaurants   Int            @default(0)
  deliveryMen   Int            @default(0)
  status        String         @default("Active")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Cuisine {
  id            String         @id @default(uuid())
  name          String         @unique
  restaurants   Int            @default(0)
  status        String         @default("Active")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model BusinessSettings {
  id              String       @id @default(uuid())
  businessName    String       @default("ማእድ Food Delivery")
  supportEmail    String       @default("support@maed.com")
  supportPhone    String       @default("+251 900 000 000")
  currency        String       @default("ETB")
  deliveryFee     Float        @default(50)
  commissionRate  Float        @default(15)
  updatedAt       DateTime     @updatedAt
}

model SupportMessage {
  id          String   @id @default(uuid())
  senderId    String
  senderName  String
  senderRole  String   @default("CUSTOMER")
  text        String
  recipientId String?
  isFromAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}