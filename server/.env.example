# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/roms_db"

# Server Configuration
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# CORS (Frontend URL)
CORS_ORIGIN="http://localhost:5173"

# Google OAuth (Optional - for social login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Gemini AI (for chatbot support)
GEMINI_API_KEY="your-gemini-api-key"

# Payment Gateway (Optional - for production)
CHAPA_SECRET_KEY="your-chapa-secret-key"
TELEBIRR_APP_ID="your-telebirr-app-id"
TELEBIRR_APP_KEY="your-telebirr-app-key"

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR="./uploads"

# Production Settings
# For production, update these:
# DATABASE_URL="postgresql://user:pass@host:5432/production_db"
# CORS_ORIGIN="https://your-frontend-domain.com"
# NODE_ENV="production"
# JWT_SECRET="<generate with: openssl rand -base64 32>"
