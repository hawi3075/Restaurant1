# Backend API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Ensure "Maps JavaScript API" and "Geocoding API" are enabled on your Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Translate API Key (Optional - for translation features)
VITE_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Production Settings
# For production deployment, update these:
# VITE_API_URL=https://your-backend-domain.com/api
# VITE_SOCKET_URL=https://your-backend-domain.com
